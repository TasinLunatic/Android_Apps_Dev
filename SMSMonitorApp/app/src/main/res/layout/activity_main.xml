<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:padding="20dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS Monitor"
            android:textColor="@color/primary_purple"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Content Provider + ContentObserver"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Refresh Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Refresh SMS List"
        android:textSize="16sp"
        android:textColor="@color/black"
        app:backgroundTint="@color/primary_purple"
        app:icon="@android:drawable/ic_popup_sync"
        app:iconTint="@color/black"
        app:iconGravity="textStart"
        app:cornerRadius="14dp"
        android:padding="14dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No SMS found\n\nSend a test SMS using the emulator\nthen click Refresh"
        android:textSize="16sp"
        android:textColor="@color/text_hint"
        android:visibility="gone"
        android:padding="32dp" />

    <!-- SMS List -->
    <ListView
        android:id="@+id/sms_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:background="@color/background_dark" />

</LinearLayout>